{
  "id": "/",
  "name": "Hopnote — Beer Tasting Journal",
  "short_name": "Hopnote",
  "description": "Find your flavour, note every pour, and keep a personal atlas of the beers worth remembering.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#162019",
  "theme_color": "#162019",
  "categories": ["lifestyle", "productivity"],
  "shortcuts": [
    {
      "name": "Log a tasting",
      "short_name": "Log tasting",
      "description": "Open the new tasting dialog",
      "url": "/?new=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Scan a bottle",
      "short_name": "Scan bottle",
      "description": "Scan an EAN and fill in the beer details",
      "url": "/?scan=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open journal",
      "short_name": "Journal",
      "description": "See every pour you have recorded",
      "url": "/journal",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
